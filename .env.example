# Скопируйте в .env и заполните. Файл .env в git не добавляйте.

# Пароль базы данных. Длинная случайная строка:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Ключ подписи входа (JWT), не короче 32 символов:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если его сменить, все ведущие выйдут из системы.
JWT_SECRET=

# Локальный запуск (docker compose up): адрес и порт страницы.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Выкладка с HTTPS (docker-compose.prod.yml): домен, который указывает на сервер.
DOMAIN=
